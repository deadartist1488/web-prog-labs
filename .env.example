# Скопируйте в .env и поменяйте значения. Сам .env в git не попадает (.gitignore).
ENVIRONMENT=prod
LOG_LEVEL=INFO

POSTGRES_USER=library
POSTGRES_PASSWORD=change-me
POSTGRES_DB=library
# для запуска без Docker; в docker-compose DATABASE_URL собирается из POSTGRES_*
DATABASE_URL=sqlite:///./library.db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# fake:// = Redis в памяти процесса (только для разработки)
REDIS_URL=fake://

# openssl rand -hex 32
SECRET_KEY=replace-with-64-hex-chars
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
SESSION_TTL_HOURS=24

CORS_ORIGINS=["https://library.local"]
COOKIE_SECURE=true
LOGIN_MAX_ATTEMPTS=5

MAX_ACTIVE_LOANS=5
CACHE_TTL_SECONDS=60
RUN_WORKER=false

# первый администратор создаётся при старте, если задан
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin1
